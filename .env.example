# ── Core ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth / app ────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Billing ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=

# ── Swap Test (MASTER_BUILD_SWAP_TEST) ────────────────────────────
# OPTIONAL — Upstash Redis REST. Counters default to the swap_kv
# table in Supabase (no extra service); set these to switch to Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# OPTIONAL — Cloudflare Turnstile human-check from scan 2 upward.
# Unset = the ladder/IP-ceiling/windows/breaker defend alone, and the
# circuit breaker fails closed for anonymous scans when tripped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Shared secret for the four cron routes (warm/outcomes/cleanup/vocab-purge)
CRON_SECRET=
# Salt for the anonymous-scan fingerprint hash (fraud only, 30d rolling)
FINGERPRINT_SALT=
# Launch flag — swap-test surfaces stay unreachable until "true"
SWAP_TEST_ENABLED=

# ── Misc ──────────────────────────────────────────────────────────
CONSENT_LOG_SALT=
